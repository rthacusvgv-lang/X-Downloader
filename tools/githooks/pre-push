#!/bin/sh
# The last gate before anything leaves this machine: scans every commit that is about to be pushed. For a new
# branch, a brand-new remote or a remote tip this clone does not have, that is every commit no remote has yet,
# i.e. the whole history on the first push.
# Enable once per clone:  git config core.hooksPath tools/githooks
remote=$1
root=$(git rev-parse --show-toplevel) || exit 1
status=0
while read -r _ local_sha _ remote_sha; do
  case $local_sha in *[!0]*) ;; *) continue ;; esac            # all zeros: a branch is being deleted, nothing is sent
  if git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    range="$remote_sha..$local_sha"
  else
    range="$local_sha --not --remotes=$remote"
  fi
  # shellcheck disable=SC2086  (the range is several words on purpose)
  git -c core.quotepath=off log -p -m --no-color --no-ext-diff --format= --diff-filter=ACMRT $range \
    | sh "$root/tools/check-secrets.sh" || status=1
done
exit $status
